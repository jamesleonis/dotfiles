#!/usr/bin/env sh

# I have a preferred default setup for my development work. Briefly, the layout
# is the first window with two panes for utility work, the second window for my
# (Neo)VIM session, and the third window with two panes split vertically I use
# for GIT.

SESSION_NAME=$1

# Create the first window, split it down the middle. I use this for utilities
# like a Clojure REPL, docker, servers, quick edits, etc.
tmux new-session -d -s "$SESSION_NAME" -n "utils"
tmux split-pane -t "$SESSION_NAME:1" -h

# Create the second window where my main editor (Neo)VIM lives.
tmux new-window -t "$SESSION_NAME:2" -n "Editor"
tmux send-keys -t "$SESSION_NAME:2" "nvim" C-m

# Create the third window for GIT operations. I usually run a graph of commits
# on the left and status on the right. Alternatively I'll view a staged diff
# on the left and the commit message (in VIM) on the right.
tmux new-window -t "$SESSION_NAME:3" -n "GIT"
tmux send-keys -t "$SESSION_NAME:3" "git log --oneline --decorate --graph" C-m
tmux split-pane -t "$SESSION_NAME:3" -h
tmux send-keys -t "$SESSION_NAME:3.1" "git status" C-m

# Default to my editor screen
tmux select-window -t "$SESSION_NAME:2"

# Attach to the new session
tmux attach-session -t "$SESSION_NAME"
